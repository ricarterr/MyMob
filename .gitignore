# ##############################################################################
# MYMOB - .gitignore Profissional para Produção SaaS
# ##############################################################################

# Dependências e Pacotes
node_modules/
/jspm_packages/
web_modules/

# Builds e Saídas de Produção
.next/
out/
build/
dist/
/public/build/
/public/dist/
bin/
obj/

# TypeScript e Compiladores
*.tsbuildinfo

# Variáveis de Ambiente e Segredos (Segurança SaaS Crítica)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.staging.local
*.env
*.env.local
.env.*
!.env.example

# Logs de Erros e Depuração
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log
logs/
*.log.*

# Sessões Locais e Autenticação do WhatsApp API (Baileys, Wwebjs, Venom, etc.)
.wwebjs_auth/
.wwebjs_cache/
whatsapp-session*/
*session*.json
sessions/
/sessions/
auth_info_multi/
tokens/
*.tokens

# Arquivos de Integração do Supabase
.supabase/
supabase/.temp/
supabase/functions/.import/
supabase/.local/

# Arquivos de Integração e Deploy da Vercel
.vercel/
.vercel

# Arquivos do Sistema Operacional
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
*.db

# Configurações de IDEs e Editores de Código
.idea/
.vscode/
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.project
.classpath
.settings/

# Testes, Cobertura e Cache de Linter
coverage/
.nyc_output/
htmlcov/
.eslintcache
.stylelintcache
.prettiercache
.turbo/

# Arquivos Temporários
*.tmp
*.temp
tmp/
temp/
/tmp/
/temp/

# PWA
sw.js
workbox-*.js

# local database
*.sqlite
*.sqlite3

# uploads
uploads/
